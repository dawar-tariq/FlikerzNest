{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "flikerz-nest.vercel.app" }],
      "destination": "https://flickerz.dpdns.org/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/movie/:slug",
      "destination": "/api/seo-page?type=movie&slug=:slug"
    },
    {
      "source": "/tv/:slug",
      "destination": "/api/seo-page?type=tv&slug=:slug"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/tmdb-api/:path*",
      "destination": "https://api.themoviedb.org/3/:path*"
    },
    {
      "source": "/tmdb-image/:path*",
      "destination": "https://image.tmdb.org/t/p/:path*"
    }
  ]
}
